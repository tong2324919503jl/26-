B2C;fontSize=13;spacing=3;labelBackgroundColor=none;fontBackgroundColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="24.57000000000001" y="159.894" width="154.97999999999996" height="54.431999999999995" /></mxCell><mxCell id="generate" value="&lt;div style=&quot;font-family:SimSun;font-size:13px;line-height:1.2;font-weight:normal;background:transparent;&quot;&gt;按本层步长生成候选点&lt;br&gt;保留旧点，补充镜像点&lt;br&gt;与安全边界点&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5CCD0;strokeColor=#B98585;strokeWidth=1;shadow=0;fontFamily=SimSun;fontColor=#352B2C;fontSize=13;spacing=3;labelBackgroundColor=none;fontBackgroundColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="24.57000000000001" y="221.886" width="154.97999999999996" height="51.408" /></mxCell><mxCell id="candidate" value="&lt;div style=&quot;font-family:SimSun;font-size:13px;line-height:1.2;font-weight:normal;background:transparent;&quot;&gt;取本层候选点 q∈F&lt;br&gt;依次计算单点评分&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5CCD0;strokeColor=#B98585;strokeWidth=1;shadow=0;fontFamily=SimSun;fontColor=#352B2C;fontSize=13;spacing=3;labelBackgroundColor=none;fontBackgroundColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="24.57000000000001" y="288.22499999999997" width="154.97999999999996" height="39.69" /></mxCell><mxCell id="analytic" value="&lt;div style=&quot;font-family:SimSun;font-size:13px;line-height:1.2;font-weight:normal;background:transparent;&quot;&gt;先计算解析上界 A(q)&lt;br&gt;构造 Q(q)，置 b₀=0&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5CCD0;strokeColor=#B98585;strokeWidth=1;shadow=0;fontFamily=SimSun;fontColor=#352B2C;fontSize=13;spacing=3;labelBackgroundColor=none;fontBackgroundColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="223.02" y="288.22499999999997" width="154.97999999999996" height="39.69" /></mxCell><mxCell id="cell" value="&lt;div style=&quot;font-family:SimSun;font-size:13px;line-height:1.2;font-weight:normal;background:transparent;&quot;&gt;逐读数单元求直径 Dₖ&lt;br&gt;几何约束同步半步增宽&lt;br&gt;更新 bₜ=max{bₜ₋₁,Dₖ}&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5CCD0;strokeColor=#B98585;strokeWidth=1;shadow=0;fontFamily=SimSun;fontColor=#352B2C;fontSize=13;spacing=3;labelBackgroundColor=none;fontBackgroundColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="223.02" y="221.886" width="154.97999999999996" height="51.408" /></mxCell><mxCell id="full" value="&lt;div style=&quot;font-family:SimSun;font-size:13px;line-height:1.2;font-weight:normal;background:transparent;&quot;&gt;完整扫描：B(q)=bₜ&lt;br&gt;C(q)=min{A(q),B(q)}&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5CCD0;strokeColor=#B98585;strokeWidth=1;shadow=0;fontFamily=SimSun;fontColor=#352B2C;fontSize=13;spacing=3;labelBackgroundColor=none;fontBackgroundColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="223.02" y="46.305" width="154.97999999999996" height="39.69" /></mxCell><mxCell id="aggregate" value="&lt;div style=&quot;font-family:SimSun;font-size:13px;line-height:1.2;font-weight:normal;background:transparent;&quot;&gt;汇总本层全部候选评分&lt;br&gt;更新当前优选点&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5CCD0;strokeColor=#B98585;strokeWidth=1;shadow=0;fontFamily=SimSun;fontColor=#352B2C;fontSize=13;spacing=3;labelBackgroundColor=none;fontBackgroundColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="421.4699999999999" y="46.305" width="154.97999999999996" height="39.69" /></mxCell><mxCell id="final" value="&lt;div style=&quot;font-family:SimSun;font-size:13px;line-height:1.2;font-weight:normal;background:transparent;&quot;&gt;按0.1°读数网格统一精度&lt;br&gt;复核全部已访问候选&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5CCD0;strokeColor=#B98585;strokeWidth=1;shadow=0;fontFamily=SimSun;fontColor=#352B2C;fontSize=13;spacing=3;labelBackgroundColor=none;fontBackgroundColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="421.4699999999999" y="16